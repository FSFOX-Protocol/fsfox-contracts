# Environment Settings for FSFOX Token Project

# Deployer/operator private key (without 0x).
# Use a DEDICATED low-balance gas wallet only. NEVER put the key of the
# Gnosis Safe owner or any wallet holding real funds here.
# This file is copied to .env, which is git-ignored. Never commit .env.
PRIVATE_KEY=your_private_key_here

# Polygon Network RPC URL
POLYGON_RPC_URL=https://polygon-rpc.com

# Amoy Network RPC URL (Testnet)
AMOY_RPC_URL=https://polygon-amoy.public.blastapi.io

# Polygonscan API Key for Contract Verification
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Enable Gas Reporting (Optional)
REPORT_GAS=true

# Additional Settings
# Owner Wallet Address (Optional - can be extracted from private key)
OWNER_ADDRESS=

# DEX Settings
# Uniswap V3 Factory Contract Address on Polygon
UNISWAP_V3_FACTORY=0x1F98431c8aD98523631AE4a59f267346ea31F984

# QuickSwap Factory Contract Address on Polygon
QUICKSWAP_FACTORY=0x5757371414417b8C6CAad45bAeF941aBc7d3Ab32
